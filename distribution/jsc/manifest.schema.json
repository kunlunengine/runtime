{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kunlunengine/runtime/blob/main/distribution/jsc/manifest.schema.json",
  "title": "Kunlun JavaScriptCore distribution manifest",
  "description": "Schema v1 for pinned WebKit inputs and Kunlun JSC artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "distribution",
    "source",
    "build",
    "toolchains",
    "targets",
    "patches",
    "licenses",
    "abi"
  ],
  "properties": {
    "$schema": {
      "const": "./manifest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "distribution": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "toolchains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/toolchain"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "patches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/license"
      }
    },
    "abi": {
      "$ref": "#/$defs/abi"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "commit_url"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/WebKit/WebKit.git"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "driver",
        "arguments",
        "environment",
        "feature_flags"
      ],
      "properties": {
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "$ref": "#/$defs/relativePath"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "macos",
            "linux"
          ],
          "properties": {
            "macos": {
              "$ref": "#/$defs/buildArguments"
            },
            "linux": {
              "$ref": "#/$defs/buildArguments"
            }
          }
        },
        "environment": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "feature_flags": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "string",
              "number"
            ]
          },
          "required": [
            "ENABLE_DFG_JIT",
            "ENABLE_FTL_JIT",
            "ENABLE_JSC_GLIB_API",
            "ENABLE_JIT",
            "ENABLE_REMOTE_INSPECTOR",
            "ENABLE_SAMPLING_PROFILER",
            "ENABLE_STATIC_JSC",
            "ENABLE_WEBASSEMBLY",
            "ENABLE_WEBASSEMBLY_BBQJIT",
            "ENABLE_WEBASSEMBLY_OMGJIT",
            "EVENT_LOOP_TYPE",
            "USE_LIBBACKTRACE"
          ]
        }
      }
    },
    "buildArguments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host",
        "container_image",
        "tools"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "enum": [
            "macos",
            "linux"
          ]
        },
        "container_image": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[^@]+@sha256:[0-9a-f]{64}$"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triple",
        "os",
        "arch",
        "libc",
        "toolchain",
        "deployment_target",
        "artifact"
      ],
      "properties": {
        "triple": {
          "enum": [
            "aarch64-apple-darwin",
            "x86_64-apple-darwin",
            "aarch64-unknown-linux-gnu",
            "x86_64-unknown-linux-gnu"
          ]
        },
        "os": {
          "enum": [
            "macos",
            "linux"
          ]
        },
        "arch": {
          "enum": [
            "arm64",
            "x64"
          ]
        },
        "libc": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "deployment_target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minimum"
          ],
          "properties": {
            "kind": {
              "enum": [
                "macos",
                "glibc"
              ]
            },
            "minimum": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "archive_path",
        "sha256",
        "library_paths",
        "sbom",
        "provenance"
      ],
      "properties": {
        "status": {
          "enum": [
            "planned",
            "published"
          ]
        },
        "archive_path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "library_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "sbom": {
          "$ref": "#/$defs/evidence"
        },
        "provenance": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "planned"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "null"
              },
              "sbom": {
                "$ref": "#/$defs/plannedEvidence"
              },
              "provenance": {
                "$ref": "#/$defs/plannedEvidence"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "sbom": {
                "$ref": "#/$defs/publishedEvidence"
              },
              "provenance": {
                "$ref": "#/$defs/publishedEvidence"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "sha256"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "plannedEvidence": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "properties": {
            "sha256": {
              "type": "null"
            }
          }
        }
      ]
    },
    "publishedEvidence": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "purpose",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "spdx_expression",
        "source",
        "sha256"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "spdx_expression": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "enum": [
                "local",
                "upstream"
              ]
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shim_version",
        "public_headers"
      ],
      "properties": {
        "shim_version": {
          "type": "integer",
          "minimum": 1
        },
        "public_headers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    }
  }
}
