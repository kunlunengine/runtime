+/* Kunlun's heap telemetry adapter. Values are copied across the private C
+ * extension boundary; no Heap, VM, or GC-owned pointer is exposed. */
+#include "Heap.h"
+
+extern "C" {
+JS_EXPORT bool JSKunlunGetHeapStatistics(
+    JSGlobalContextRef, uint64_t*, uint64_t*, uint64_t*);
+}
+
+extern "C" JS_EXPORT bool JSKunlunGetHeapStatistics(
+    JSGlobalContextRef context, uint64_t* size, uint64_t* capacity,
+    uint64_t* extraMemorySize)
+{
+    if (!context || !size || !capacity || !extraMemorySize)
+        return false;
+    auto* globalObject = toJS(context);
+    JSC::JSLockHolder locker(globalObject);
+    auto& heap = globalObject->vm().heap;
+    auto& objectSpace = heap.objectSpace();
+    static_assert(sizeof(size_t) <= sizeof(uint64_t));
+    *size = static_cast<uint64_t>(objectSpace.size());
+    *capacity = static_cast<uint64_t>(objectSpace.capacity());
+    *extraMemorySize = static_cast<uint64_t>(heap.extraMemorySize());
+    return true;
+}
